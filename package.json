{
  "name": "funny-shooter-22",
  "version": "2.1.0",
  "description": "Static site generator for hosting free online browser games on GitHub Pages",
  "scripts": {
    "build": "node generate.js",
    "validate": "node scripts/validate-games.js",
    "sync-data": "node scripts/update-data.js",
    "cleanup": "node scripts/cleanup-orphaned-pages.js",
    "convert-thumbnails": "node scripts/convert-thumbnails-webp.js",
    "generate-fallback-thumb": "node scripts/generate-fallback-thumbnail.js",
    "update-all": "npm run sync-data && npm run cleanup && npm run validate && npm run build",
    "clean": "rm -rf dist/",
    "prebuild": "npm run validate",
    "dev": "npm run build && npx serve dist -p 3000",
    "lint": "eslint generate.js scripts/*.js src/**/*.js",
    "format": "prettier --write '**/*.{js,json,md}' '!dist/**' '!node_modules/**'",
    "format:check": "prettier --check '**/*.{js,json,md}' '!dist/**' '!node_modules/**'"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "serve": "^14.2.1"
  },
  "keywords": [
    "games",
    "online",
    "free",
    "browser-games",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/funny-shooter-22/funny-shooter-22.github.io.git"
  },
  "author": "Funny Shooter 22 Team",
  "license": "MIT"
}
